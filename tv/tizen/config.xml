<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://nexoraweb.ch/nexora" version="1.0.0" viewmodes="maximized">
    <tizen:application id="NxOraTv001.NEXORA" package="NxOraTv001" required_version="2.3"/>
    <name>NEXORA</name>
    <description>NEXORA – TV player for your own playlist (Xtream Codes, M3U) with TV guide.</description>
    <author href="https://nexoraweb.ch" email="egz0nn@live.com">NEXORA</author>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <access origin="*" subdomains="true"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:content-security-policy>default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; media-src * blob: data:;</tizen:content-security-policy>
</widget>
